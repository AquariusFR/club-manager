# ==========================================================
# RCBA - Configuration Apache
# Racine : /public/
# ==========================================================


# ----------------------------------------------------------
# 1. HTTPS
# ----------------------------------------------------------
# Redirige HTTP vers HTTPS.
#
# À conserver uniquement si ton domaine dispose bien d'un
# certificat SSL actif sur IONOS.
# ----------------------------------------------------------

<IfModule mod_rewrite.c>

    RewriteEngine On

    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

</IfModule>


# ----------------------------------------------------------
# 2. Désactivation du listing des répertoires
# ----------------------------------------------------------
# Évite qu'un visiteur puisse obtenir une liste des fichiers
# d'un répertoire s'il n'y a pas de index.html/index.php.
# ----------------------------------------------------------

Options -Indexes


# ----------------------------------------------------------
# 3. Compression GZIP
# ----------------------------------------------------------
# Réduit fortement la taille transférée pour HTML/CSS/JS/JSON
# et SVG.
#
# Ne pas compresser les JPEG/PNG/WebP/AVIF :
# ils sont déjà compressés.
# ----------------------------------------------------------

<IfModule mod_deflate.c>

    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml

</IfModule>


# ----------------------------------------------------------
# 4. Cache navigateur
# ----------------------------------------------------------

<IfModule mod_expires.c>

    ExpiresActive On

    # ------------------------------------------------------
    # HTML
    # ------------------------------------------------------
    # Les pages peuvent changer régulièrement.
    # 5 minutes de cache puis vérification.
    # ------------------------------------------------------

    ExpiresByType text/html "access plus 5 minutes"


    # ------------------------------------------------------
    # CSS
    # ------------------------------------------------------

    ExpiresByType text/css "access plus 1 year"


    # ------------------------------------------------------
    # JavaScript
    # ------------------------------------------------------

    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"


    # ------------------------------------------------------
    # Images
    # ------------------------------------------------------

    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"


    # ------------------------------------------------------
    # Fonts
    # ------------------------------------------------------

    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"


    # ------------------------------------------------------
    # JSON
    # ------------------------------------------------------
    # Pour l'instant, tes API peuvent être dynamiques.
    # On garde donc un cache court.
    # ------------------------------------------------------

    ExpiresByType application/json "access plus 1 minute"

</IfModule>


# ----------------------------------------------------------
# 5. Cache-Control
# ----------------------------------------------------------
# On donne explicitement au navigateur les règles de cache.
# ----------------------------------------------------------

<IfModule mod_headers.c>

    # ------------------------------------------------------
    # Assets statiques
    # ------------------------------------------------------
    # CSS / JS / images / fonts / SVG
    #
    # 31536000 = 1 an
    #
    # "immutable" est volontaire :
    # ces fichiers doivent être versionnés lorsqu'ils changent.
    # Exemple :
    #
    # components.css?v=1.0.1
    #
    # ------------------------------------------------------

    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|avif|svg|woff|woff2)$">

        Header set Cache-Control "public, max-age=31536000, immutable"

    </FilesMatch>


    # ------------------------------------------------------
    # HTML
    # ------------------------------------------------------
    # Cache court.
    # ------------------------------------------------------

    <FilesMatch "\.(html)$">

        Header set Cache-Control "public, max-age=300, must-revalidate"

    </FilesMatch>


    # ------------------------------------------------------
    # JSON
    # ------------------------------------------------------
    # Cache court pour les éventuelles réponses JSON statiques.
    # ------------------------------------------------------

    <FilesMatch "\.json$">

        Header set Cache-Control "public, max-age=60, must-revalidate"

    </FilesMatch>


    # ------------------------------------------------------
    # Sécurité : empêcher le navigateur d'interpréter un
    # fichier avec un autre type MIME.
    # ------------------------------------------------------

    Header set X-Content-Type-Options "nosniff"


    # ------------------------------------------------------
    # Referrer Policy
    # ------------------------------------------------------

    Header set Referrer-Policy "strict-origin-when-cross-origin"


    # ------------------------------------------------------
    # Permissions Policy
    # ------------------------------------------------------
    # On désactive les fonctionnalités dont ton site n'a pas
    # besoin.
    # ------------------------------------------------------

    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"

</IfModule>


# ----------------------------------------------------------
# 6. Protection des fichiers sensibles
# ----------------------------------------------------------
# Empêche l'accès HTTP aux fichiers de configuration cachés.
#
# Cela concerne notamment .htaccess, .htpasswd, etc.
# ----------------------------------------------------------

<FilesMatch "^\.">

    Require all denied

</FilesMatch>


# ----------------------------------------------------------
# FIN
# ----------------------------------------------------------